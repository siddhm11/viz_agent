```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    from scipy.stats import spearmanr
    warnings.filterwarnings('ignore')
    
    try:
        # Data validation
        required_cols = ['Avg_Daily_Usage_Hours', 'Addicted_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        # Check for required columns
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
            
        # Validate data types
        if not (isinstance(data['Avg_Daily_Usage_Hours'], pd.core.series.Series) and 
                data['Avg_Daily_Usage_Hours'].dtype.kind in 'f'):
            return None, "Avg_Daily_Usage_Hours must be a numeric column", False
            
        if not (isinstance(data['Addicted_Score'], pd.core.series.Series) and 
                data['Addicted_Score'].dtype.kind in 'i'):
            return None, "Addicted_Score must be an integer column", False
            
        # Data preparation
        df = data[['Avg_Daily_Usage_Hours', 'Addicted_Score']].copy()
        
        # Handle edge cases
        if df.empty:
            return None, "No data available for visualization", False
            
        if len(df['Addicted_Score'].unique()) == 1:
            return None, "Not enough variation in Addicted_Score for meaningful visualization", False
            
        # Ensure proper data types
        df['Avg_Daily_Usage_Hours'] = pd.to_numeric(df['Avg_Daily_Usage_Hours'], errors='coerce')
        df['Addicted_Score'] = pd.to_numeric(df['Addicted_Score'], errors='coerce')
        
        # Drop any rows with invalid conversions
        df.dropna(subset=['Avg_Daily_Usage_Hours', 'Addicted_Score'], inplace=True)
        
        if df.empty:
            return None, "No valid data available after cleaning", False
            
        # Create visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        # Use pointplot for categorical x-axis
        sns.pointplot(x='Addicted_Score', y='Avg_Daily_Usage_Hours', 
                      data=df, ci=None, errorbar=None)
        
        plt.title('Average Daily Usage Hours by Addiction Score')
        plt.xlabel('Addiction Score')
        plt.ylabel('Average Daily Usage Hours')
        plt.grid(True, alpha=0.3)
        
        # Statistical insights
        correlation, pvalue = spearmanr(df['Addicted_Score'], df['Avg_Daily_Usage_Hours'])
        summary_stats = df.groupby('Addicted_Score')['Avg_Daily_Usage_Hours'].agg(
            ['mean', 'median', 'std', 'count'])
        
        insights = f"""
        Scatter Plot Insights:
        - Spearman Correlation: {correlation:.2f} (p-value: {pvalue:.2f})
        - Summary Statistics by Addiction Score:
          {summary_stats}
        - The plot shows the relationship between average daily usage hours and addiction score.
        - Points are distributed to show central tendency and variability.
        - Outliers are visible where usage hours deviate significantly from the mean.
        """
        
        # Convert plot to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
