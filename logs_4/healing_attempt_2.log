    def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Academic_Level', 'Mental_Health_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Input data must be a pandas DataFrame", False
        
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Validate column data types
        academic_level = data['Academic_Level']
        mental_health = data['Mental_Health_Score']
        
        if not isinstance(academic_level, pd.core.series.Series):
            return None, "Academic_Level must be a pandas Series", False
        if not (academic_level.dtype == 'object' or academic_level.dtype == 'category'):
            return None, "Academic_Level must be categorical", False
        
        if not isinstance(mental_health, pd.core.series.Series):
            return None, "Mental_Health_Score must be a pandas Series", False
        if not np.issubdtype(mental_health.dtype, np.number):
            return None, "Mental_Health_Score must be numeric", False
        
        # Check for missing values (though user specified 0 missing)
        if academic_level.isnull().any() or mental_health.isnull().any():
            return None, "Missing values detected in the data", False
        
        # Data preparation
        # Ensure proper types
        data['Academic_Level'] = academic_level.astype('category')
        data['Mental_Health_Score'] = pd.to_numeric(mental_health, errors='coerce')
        
        # Validate after conversion
        if not data['Mental_Health_Score'].notnull().all():
            return None, "Non-numeric values found in Mental_Health_Score", False
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        ax = sns.boxplot(x='Academic_Level', y='Mental_Health_Score', 
                        data=data, ci=None)
        
        # Customize the plot
        plt.title('Distribution of Mental Health Scores by Academic Level', 
                 fontsize=14, fontweight='bold')
        plt.xlabel('Academic Level', fontsize=12)
        plt.ylabel('Mental Health Score', fontsize=12)
        plt.xticks(fontsize=10)
        plt.yticks(fontsize=10)
        plt.grid(True, alpha=0.3)
        
        # Generate statistical insights
        insights = []
        for level in data['Academic_Level'].cat.categories:
            group = data[data['Academic_Level'] == level]
            median = group['Mental_Health_Score'].median()
            mean = group['Mental_Health_Score'].mean()
            std_dev = group['Mental_Health_Score'].std()
            min_val = group['Mental_Health_Score'].min()
            max_val = group['Mental_Health_Score'].max()
            
            insights.append(f"For {level}: ")
            insights.append(f"Median = {median:.2f}, Mean = {mean:.2f}, Std Dev = {std_dev:.2f}")
            insights.append(f"Range: [{min_val}, {max_val}]")
        
        outlier_low = data['Mental_Health_Score'].quantile(0.01)
        outlier_high = data['Mental_Health_Score'].quantile(0.99)
        outliers = data[(data['Mental_Health_Score'] < outlier_low) | 
                       (data['Mental_Health_Score'] > outlier_high)]
        
        if not outliers.empty:
            insights.append(f"Outliers detected in the data: {len(outliers)} cases")
        
        # Join insights into a single string
        insights_text = "\n".join(insights)
        
        # Convert plot to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights_text, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
    ```

