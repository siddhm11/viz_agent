                return None, f"Could not convert {age_col} to integer: {str(e)}", False
        
        # Validate Usage column
        if not np.issubdtype(data[usage_col].dtype, np.floating):
            try:
                data[usage_col] = pd.to_numeric(data[usage_col], downcast='float')
