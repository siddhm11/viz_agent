        std_dev = plot_data[usage_col].std()
        
        insights.append(f"Mean usage: {mean_usage:.2f} hours")
        insights.append(f"Median usage: {median_usage:.2f} hours")
        insights.append(f"Standard deviation: {std_dev:.2f} hours")
        
