    def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Academic_Level', 'Avg_Daily_Usage_Hours', 'Mental_Health_Score']
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Check data types
        if not (data['Academic_Level'].dtype == 'object'):
            raise TypeError("Academic_Level must be of type object")
        if not (data['Avg_Daily_Usage_Hours'].dtype == 'float64'):
            raise TypeError("Avg_Daily_Usage_Hours must be of type float64")
        if not (data['Mental_Health_Score'].dtype == 'int64'):
            raise TypeError("Mental_Health_Score must be of type int64")
        
        # Check for missing values
        missing_values = data[required_cols].isnull().sum().sum()
        if missing_values > 0:
            raise ValueError("Dataset contains missing values")
        
        # Validate categorical variable
        academic_levels = data['Academic_Level'].unique()
        if len(academic_levels) != 3:
            raise ValueError(f"Expected 3 unique Academic Levels, found {len(academic_levels)}")
        
        # Validate numerical ranges
        if (data['Avg_Daily_Usage_Hours'] < 0).any() or (data['Avg_Daily_Usage_Hours'] > 24).any():
            raise ValueError("Avg_Daily_Usage_Hours contains invalid values")
        if (data['Mental_Health_Score'] < 1).any() or (data['Mental_Health_Score'] > 10).any():
            raise ValueError("Mental_Health_Score contains invalid values")
        
        # Data preparation
        df = data.copy()
        df['Academic_Level'] = pd.Categorical(df['Academic_Level']).codes
        df['Mental_Health_Score'] = df['Mental_Health_Score'].astype(float)
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid", {"xtick.bottom": True, "ytick.left": True})
        
        ax = sns.violinplot(x='Academic_Level', y='Avg_Daily_Usage_Hours', 
                            hue='Mental_Health_Score', data=df, palette='viridis',
                            inner='quartile', scale='width', order=None, 
                            hue_order=None, split=True, 
                            orient=None, saturation=0.75, violin_colors=None)
        
        plt.title('Distribution of Average Daily Usage Hours by Academic Level and Mental Health Score')
        plt.xlabel('Academic Level')
        plt.ylabel('Average Daily Usage Hours')
        plt.legend(title='Mental Health Score', bbox_to_anchor=(1.05, 1), loc='upper left')
        plt.tight_layout()
        
        # Generate insights
        insights = []
        for level in academic_levels:
            level_df = df[df['Academic_Level'] == level]
            mean_usage = level_df['Avg_Daily_Usage_Hours'].mean()
            median_usage = level_df['Avg_Daily_Usage_Hours'].median()
            std_usage = level_df['Avg_Daily_Usage_Hours'].std()
            insights.append(f"Academic Level {level} has mean usage of {mean_usage:.2f} hours, "
                           f"median of {median_usage:.2f}, and standard deviation of {std_usage:.2f}")
        
        mental_health_scores = df['Mental_Health_Score'].unique()
        for score in mental_health_scores:
            score_df = df[df['Mental_Health_Score'] == score]
            mean_usage = score_df['Avg_Daily_Usage_Hours'].mean()
            insights.append(f"Mental Health Score {int(score)} has mean usage of {mean_usage:.2f} hours")
        
        insights = "\n".join(insights)
        
        # Convert to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
    ```

