```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Relationship_Status', 'Mental_Health_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Validate column data types
        if data['Relationship_Status'].dtype != 'object':
            return None, "Error: Relationship_Status must be categorical (object) type", False
            
        if data['Mental_Health_Score'].dtype != 'int64':
            return None, "Error: Mental_Health_Score must be int64 type", False
        
        # Check for missing values
        cols = ['Relationship_Status', 'Mental_Health_Score']
        if data[cols].isnull().values.any():
            return None, "Error: Dataset contains missing values", False
        
        # Data preparation
        df = data.copy()
        df['Relationship_Status'] = df['Relationship_Status'].astype('category')
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_theme(style="whitegrid", palette="husl")
        
        # Handle categorical variable with many levels
        if len(df['Relationship_Status'].unique()) > 10:
            df['Relationship_Status'] = df['Relationship_Status'].apply(lambda x: x[:10] + ('...' if len(x) > 10 else ''))
            
        # Create boxplot
        ax = sns.catplot(x='Relationship_Status', y='Mental_Health_Score', 
                         data=df, kind='box', errorbar=None)
        
        # Customize the plot
        plt.title('Distribution of Mental Health Scores by Relationship Status', 
                  fontsize=14, fontweight='bold')
        plt.xlabel('Relationship Status', fontsize=12)
        plt.ylabel('Mental Health Score', fontsize=12)
        plt.xticks(rotation=45, ha='right')
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        
        # Generate statistical insights
        insights = []
        for status in df['Relationship_Status'].unique():
            group = df[df['Relationship_Status'] == status]
            median = group['Mental_Health_Score'].median()
            iqr = group['Mental_Health_Score'].quantile(0.75) - group['Mental_Health_Score'].quantile(0.25)
            insights.append(f"Group: {status}\nMedian: {median:.2f}\nIQR: {iqr:.2f}")
            
        insights_text = "Statistical Insights:\n" + "\n\n".join(insights)
        
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights_text, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

