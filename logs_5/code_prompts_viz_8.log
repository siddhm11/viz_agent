```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Avg_Daily_Usage_Hours', 'Sleep_Hours_Per_Night']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
        
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation and conversion
        for col in required_cols:
            if not isinstance(data[col], (pd.core.series.Series, np.ndarray)):
                return None, f"Error: {col} is not a valid series", False
            
            # Ensure numeric type
            if not np.issubdtype(data[col].dtype, np.number):
                try:
                    data[col] = data[col].astype(float)
                except ValueError:
                    return None, f"Error: Could not convert {col} to numeric type", False
        
        # Data preparation
        x = data['Avg_Daily_Usage_Hours'].values
        y = data['Sleep_Hours_Per_Night'].values
        
        if len(x) == 0 or len(y) == 0:
            return None, "Error: Empty data provided", False
        
        if np.var(x) == 0 or np.var(y) == 0:
            return None, "Error: Constant values detected in data", False
        
        # Create visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid", {'axes.edgecolor': '0.2'})
        
        # Add scatter plot with regression line
        sns.regplot(x=x, y=y, ci=None, color='skyblue', 
                    line_kws={'color': 'navy', 'linewidth': 2})
        
        plt.title('Relationship Between Daily Usage Hours and Sleep Hours')
        plt.xlabel('Average Daily Usage Hours')
        plt.ylabel('Sleep Hours Per Night')
        plt.grid(True, alpha=0.3)
        
        # Calculate and display Pearson correlation coefficient
        corr, _ = np.zeros(2), np.zeros(2)
        try:
            corr = np.corrcoef(x, y)[0, 1]
        except Exception as e:
            print(f"Error calculating correlation: {e}")
        
        # Generate insights
        insights = []
        if abs(corr) >= 0.7:
            insights.append("Strong correlation observed")
        elif abs(corr) >= 0.5:
            insights.append("Moderate correlation observed")
        else:
            insights.append("Weak or no clear correlation observed")
        
        insights.append(f"Pearson correlation coefficient: {corr:.3f}")
        insights = " ".join(insights)
        
        # Convert plot to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

