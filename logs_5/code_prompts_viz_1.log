```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    from scipy.stats import pearsonr
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Sleep_Hours_Per_Night', 'Mental_Health_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        # Check for missing columns
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
            
        # Validate data types
        sleep_col = data['Sleep_Hours_Per_Night']
        mental_col = data['Mental_Health_Score']
        
        if not (isinstance(sleep_col.dtype, np.float64) or isinstance(sleep_col.dtype, np.float32)):
            return None, "Sleep_Hours_Per_Night must be a float type", False
            
        if not (isinstance(mental_col.dtype, np.int64) or isinstance(mental_col.dtype, np.int32)):
            return None, "Mental_Health_Score must be an integer type", False
            
        # Data preparation
        sleep_data = sleep_col.values
        mental_data = mental_col.values
        
        if len(sleep_data) == 0 or len(mental_data) == 0:
            return None, "Empty data in one or more columns", False
            
        # Outlier detection and removal
        def remove_outliers(data):
            if len(data) < 2:
                return data
            q1 = np.percentile(data, 25)
            q3 = np.percentile(data, 75)
            iqr = q3 - q1
            lower_bound = q1 - (1.5 * iqr)
            upper_bound = q3 + (1.5 * iqr)
            mask = (data >= lower_bound) & (data <= upper_bound)
            return data[mask]
            
        sleep_filtered = remove_outliers(sleep_data)
        mental_filtered = remove_outliers(mental_data)
        
        if len(sleep_filtered) == 0 or len(mental_filtered) == 0:
            return None, "All data points removed after outlier detection", False
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        plt.scatter(sleep_filtered, mental_filtered, 
                    alpha=0.7, color="#2ecc71",
                    edgecolor="none", s=40)
        
        # Add regression line
        sns.regplot(x=sleep_filtered, y=mental_filtered, 
                    ci=None, color="#e74c3c", scatter=False,
                    line_kws={'linewidth': 2, 'color': "#e74c3c"})
        
        plt.title("Relationship Between Sleep Hours and Mental Health Score", 
                  fontsize=14, fontweight="bold")
        plt.xlabel("Sleep Hours Per Night", fontsize=12)
        plt.ylabel("Mental Health Score", fontsize=12)
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        
        # Generate statistical insights
        correlation_coeff, p_value = pearsonr(sleep_filtered, mental_filtered)
        insights = f"Scatter plot shows the relationship between sleep hours and mental health score.\n"
        insights += f"Pearson Correlation Coefficient: {correlation_coeff:.4f}\n"
        insights += f"P-value: {p_value:.4f}\n"
        if abs(correlation_coeff) > 0.7:
            insights += "Strong positive correlation observed between the variables."
        elif abs(correlation_coeff) > 0.5:
            insights += "Moderate positive correlation observed between the variables."
        else:
            insights += "Weak or no significant correlation observed between the variables."
            
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
