```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Country', 'Avg_Daily_Usage_Hours']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
        
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Validate data types
        if not (isinstance(data['Country'], pd.core.series.Series) and 
                data['Country'].dtype == 'object'):
            return None, "Error: 'Country' column must be of type object", False
        
        if not (isinstance(data['Avg_Daily_Usage_Hours'], pd.core.series.Series) and 
                data['Avg_Daily_Usage_Hours'].dtype == 'float64'):
            return None, "Error: 'Avg_Daily_Usage_Hours' column must be of type float64", False
        
        # Data preparation
        # Check for empty data
        if data.empty:
            return None, "Error: Empty dataset provided", False
        
        # Check for valid categorical data
        if not all(isinstance(country, str) for country in data['Country']):
            return None, "Error: 'Country' column contains non-string values", False
        
        # Check for valid numerical data
        if not all(isinstance(hours, (int, float)) for hours in data['Avg_Daily_Usage_Hours']):
            return None, "Error: 'Avg_Daily_Usage_Hours' column contains non-numeric values", False
        
        # Group by country and calculate mean usage
        country_usage = data.groupby('Country')['Avg_Daily_Usage_Hours'].mean().reset_index()
        
        # Handle large number of categories
        if len(country_usage) > 10:
            # Get top 10 countries by average usage
            top_countries = country_usage.sort_values('Avg_Daily_Usage_Hours', 
                                                       ascending=False).head(10)
            insights = f"Showing top 10 countries by average daily usage hours"
        else:
            top_countries = country_usage
            insights = f"All {len(country_usage)} countries are shown"
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        ax = sns.barplot(x='Country', y='Avg_Daily_Usage_Hours', data=top_countries)
        
        # Customize the plot
        plt.title('Average Daily Usage Hours by Country', fontsize=14, pad=20)
        plt.xlabel('Country', fontsize=12)
        plt.ylabel('Average Daily Usage Hours', fontsize=12)
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        
        # Add statistical insights
        mean_usage = top_countries['Avg_Daily_Usage_Hours'].mean()
        std_dev = top_countries['Avg_Daily_Usage_Hours'].std()
        max_usage = top_countries['Avg_Daily_Usage_Hours'].max()
        min_usage = top_countries['Avg_Daily_Usage_Hours'].min()
        
        insights += f"\nMean usage: {mean_usage:.2f} hours"
        insights += f"\nStandard deviation: {std_dev:.2f} hours"
        insights += f"\nMaximum usage: {max_usage:.2f} hours in {top_countries.loc[top_countries['Avg_Daily_Usage_Hours'].idxmax(), 'Country']}"
        insights += f"\nMinimum usage: {min_usage:.2f} hours in {top_countries.loc[top_countries['Avg_Daily_Usage_Hours'].idxmin(), 'Country']}"
        
        if max_usage > mean_usage + 2*std_dev:
            insights += "\n\nNote: The country with the highest usage appears to be an outlier"
        
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
