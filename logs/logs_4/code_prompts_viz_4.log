```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # 1. Validate required columns exist
        required_cols = ['Academic_Level', 'Affects_Academic_Performance']
        if not all(col in data.columns for col in required_cols):
            return None, "Missing required columns", False
        
        # 2. Validate data types
        academic_level = data['Academic_Level']
        affects_perf = data['Affects_Academic_Performance']
        
        # Validate Academic_Level
        if not (isinstance(academic_level, pd.core.series.Series) and 
                academic_level.dtype == 'object' and 
                len(academic_level.unique()) == 3):
            return None, "Invalid data type for Academic_Level", False
        
        # Validate Affects_Academic_Performance
        if not (isinstance(affects_perf, pd.core.series.Series) and 
                affects_perf.dtype == 'object' and 
                len(affects_perf.unique()) == 2 and
                set(affects_perf.unique()) == {'Yes', 'No'}):
            return None, "Invalid data type for Affects_Academic_Performance", False
        
        # 3. Data preparation
        # Create crosstab
        crosstab = pd.crosstab(academic_level, affects_perf)
        
        # 4. Create visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        # Create stacked bar chart
        crosstab.plot(kind='bar', stacked=True, 
                     title='Stacked Bar Chart of Academic Level vs Academic Performance Effect',
                     figsize=(10, 6), 
                     fontsize=10,
                     table=False,
                     legend=True,
                     autopct=None,
                     bottom=None,
                     stacked=True,
                     use_index=True)
        
        plt.xlabel('Academic Level')
        plt.ylabel('Count')
        plt.legend(title='Affects Academic Performance')
        plt.tight_layout()
        
        # 5. Generate insights
        total_yes = crosstab['Yes'].sum()
        total_no = crosstab['No'].sum()
        total = total_yes + total_no
        
        insights = f"Total respondents: {total}\n"
        insights += f"Proportion of 'Yes' responses: {total_yes/total:.2%}\n"
        insights += f"Proportion of 'No' responses: {total_no/total:.2%}\n\n"
        insights += "Distribution of responses across academic levels reveals:\n"
        for level in academic_level.unique():
            level_yes = crosstab.loc[level, 'Yes']
            level_no = crosstab.loc[level, 'No']
            insights += f"- {level}: {level_yes} (Yes) and {level_no} (No)\n"
        
        # 6. Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

