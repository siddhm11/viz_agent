```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    from scipy.stats import spearmanr
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Sleep_Hours_Per_Night', 'Mental_Health_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Validate data types
        sleep_col = 'Sleep_Hours_Per_Night'
        mental_col = 'Mental_Health_Score'
        
        if not pd.api.types.is_numeric_dtype(data[sleep_col]):
            return None, f"Column '{sleep_col}' must be numeric", False
            
        if not pd.api.types.is_integer_dtype(data[mental_col]):
            return None, f"Column '{mental_col}' must be integer type", False
            
        # Handle edge cases
        if data.shape[0] == 0:
            return None, "Error: Empty dataset provided", False
            
        # Drop rows with missing values
        data = data.dropna(subset=[sleep_col, mental_col])
        if data.shape[0] == 0:
            return None, "Error: No valid data after removing missing values", False
            
        # Data preparation
        sleep_data = data[sleep_col].astype(float)
        mental_data = data[mental_col].astype(int)
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_theme(style="whitegrid", palette="husl")
        
        sns.scatterplot(x=sleep_data, y=mental_data, 
                       palette=sns.color_palette("husl", len(mental_data.unique())),
                       alpha=0.7, s=80, edgecolor="black", linewidth=0.5)
        
        plt.title('Scatter Plot of Sleep Hours vs Mental Health Score', fontsize=14, pad=20)
        plt.xlabel('Sleep Hours Per Night', fontsize=12)
        plt.ylabel('Mental Health Score', fontsize=12)
        plt.grid(True, alpha=0.3)
        plt.xticks(fontsize=10)
        plt.yticks(fontsize=10)
        plt.tight_layout()
        
        # Generate statistical insights
        correlation, pvalue = spearmanr(sleep_data, mental_data)
        insights = f"Scatter plot shows the relationship between sleep hours and mental health scores.\n"
        insights += f"Spearman correlation coefficient: {correlation:.3f}\n"
        insights += f"p-value: {pvalue:.3f}\n"
        if correlation > 0:
            insights += "Positive correlation observed between sleep hours and mental health scores."
        elif correlation < 0:
            insights += "Negative correlation observed between sleep hours and mental health scores."
        else:
            insights += "No significant correlation observed."
            
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

