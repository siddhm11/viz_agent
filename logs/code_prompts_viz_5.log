```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['housing_median_age', 'total_rooms']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data preparation with type checking
        housing_median_age = data['housing_median_age']
        total_rooms = data['total_rooms']
        
        # Ensure numeric types
        if not (isinstance(housing_median_age.dtype, np.dtype) and np.issubdtype(housing_median_age.dtype, np.number)):
            return None, "housing_median_age must be numeric", False
        if not (isinstance(total_rooms.dtype, np.dtype) and np.issubdtype(total_rooms.dtype, np.number)):
            return None, "total_rooms must be numeric", False
        
        # Handle edge cases
        if housing_median_age.empty or total_rooms.empty:
            return None, "Empty data in one or more columns", False
        
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        # Add regression line
        z = np.polyfit(housing_median_age, total_rooms, 1)
        p = np.poly1d(z)
        
        plt.scatter(housing_median_age, total_rooms, 
                   alpha=0.7, 
                   s=10,
                   label='Data points')
        plt.plot(housing_median_age, p(housing_median_age), 
                "r--", 
                label='Regression line')
        
        plt.xlabel('Housing Median Age', fontsize=12)
        plt.ylabel('Total Rooms', fontsize=12)
        plt.title('Scatter Plot of Housing Median Age vs Total Rooms', fontsize=14)
        plt.legend()
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        
        # Generate statistical insights
        correlation = np.corrcoef(housing_median_age, total_rooms)[0, 1]
        insights = f"Correlation Coefficient: {correlation:.2f}\n"
        
        if abs(correlation) > 0.7:
            insights += "Strong positive correlation between housing median age and total rooms."
        elif abs(correlation) > 0.3:
            insights += "Moderate positive correlation between housing median age and total rooms."
        else:
            insights += "Weak or no significant correlation between housing median age and total rooms."
            
        # Calculate potential outliers
        residuals = total_rooms - p(housing_median_age)
        outlier_threshold = np.mean(np.abs(residuals)) * 3
        outliers = np.abs(residuals) > outlier_threshold
        outlier_count = sum(outliers)
        
        if outlier_count > 0:
            insights += f"\nDetected {outlier_count} potential outliers."
        
        # Convert to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

