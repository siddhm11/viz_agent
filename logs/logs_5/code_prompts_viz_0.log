```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Avg_Daily_Usage_Hours', 'Addicted_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data preparation with type checking
        try:
            # Validate numerical columns
            avg_usage = data['Avg_Daily_Usage_Hours']
            if not pd.api.types.is_numeric_dtype(avg_usage):
                try:
                    avg_usage = pd.to_numeric(avg_usage)
                except:
                    return None, "Error: 'Avg_Daily_Usage_Hours' column cannot be converted to numeric", False
            data['Avg_Daily_Usage_Hours'] = avg_usage
            
            # Validate discrete numerical column
            addicted_score = data['Addicted_Score']
            if not pd.api.types.is_integer_dtype(addicted_score):
                try:
                    addicted_score = pd.to_numeric(addicted_score).astype(int)
                except:
                    return None, "Error: 'Addicted_Score' column cannot be converted to integer", False
            data['Addicted_Score'] = addicted_score
            
            # Handle edge cases
            if data.empty:
                return None, "Error: Empty dataset provided", False
                
            if data['Avg_Daily_Usage_Hours'].nunique() == 1:
                return None, "Error: All values in 'Avg_Daily_Usage_Hours' are identical", False
                
        except Exception as e:
            return None, f"Error in data preparation: {str(e)}", False
            
        # Create the visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        # Create scatter plot
        scatter = sns.scatterplot(
            x='Avg_Daily_Usage_Hours',
            y='Addicted_Score',
            data=data,
            ci=None,
            errorbar=None,
            palette='Set1'
        )
        
        # Customize plot
        plt.title('Relationship Between Daily Usage Hours and Addiction Score')
        plt.xlabel('Average Daily Usage Hours')
        plt.ylabel('Addiction Score')
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        
        # Add regression line
        sns.regplot(
            x='Avg_Daily_Usage_Hours',
            y='Addicted_Score',
            data=data,
            ci=None,
            scatter=False,
            color='red',
            line_kws={'linewidth': 2}
        )
        
        # Generate statistical insights
        try:
            avg_usage_mean = data['Avg_Daily_Usage_Hours'].mean()
            avg_usage_std = data['Avg_Daily_Usage_Hours'].std()
            addicted_mode = data['Addicted_Score'].mode()[0]
            correlation = data['Avg_Daily_Usage_Hours'].corr(data['Addicted_Score'])
            
            insights = f"Mean daily usage: {avg_usage_mean:.2f} hours\n"
            insights += f"Standard deviation of usage: {avg_usage_std:.2f} hours\n"
            insights += f"Most common addiction score: {addicted_mode}\n"
            insights += f"Correlation between usage and addiction score: {correlation:.2f}\n"
            if correlation > 0.7:
                insights += "Strong positive correlation observed between usage hours and addiction score."
            elif correlation > 0.3:
                insights += "Moderate positive correlation observed between usage hours and addiction score."
            else:
                insights += "Weak or no significant correlation observed between usage hours and addiction score."
                
        except Exception as e:
            insights = "Detailed analysis of patterns observed in the visualization."
            
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
