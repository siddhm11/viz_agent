def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Most_Used_Platform', 'Conflicts_Over_Social_Media']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Validate data types
        if not pd.api.types.is_object_dtype(data['Most_Used_Platform']):
            return None, "Error: Most_Used_Platform must be categorical", False
            
        if not pd.api.types.is_integer_dtype(data['Conflicts_Over_Social_Media']):
            # Attempt to convert if possible
            try:
                data['Conflicts_Over_Social_Media'] = pd.to_numeric(
                    data['Conflicts_Over_Social_Media'], errors='coerce'
                )
                if data['Conflicts_Over_Social_Media'].isna().any():
                    return None, "Error: Non-numeric values in Conflicts_Over_Social_Media", False
            except:
                return None, "Error: Conflicts_Over_Social_Media must be numeric", False
            
        # Handle edge cases
        if data.empty:
            return None, "Error: Empty dataset provided", False
            
        if len(data['Most_Used_Platform'].unique()) == 0:
            return None, "Error: No valid categories in Most_Used_Platform", False
            
        # Data preparation
        # Group by Most_Used_Platform and calculate total conflicts
        platform_conflicts = data.groupby('Most_Used_Platform')\
                                .agg({'Conflicts_Over_Social_Media': 'sum'})\
                                .reset_index()
        
        # Create visualization
        plt.figure(figsize=(10, 6))
        sns.set_style("whitegrid")
        
        # Create stacked bar chart
        ax = sns.countplot(x="Most_Used_Platform", data=data, hue="Most_Used_Platform")
        
        # Customize the plot
        plt.title('Distribution of Conflicts by Most Used Platform', fontsize=14, pad=20)
        plt.xlabel('Most Used Platform', fontsize=12)
        plt.ylabel('Count of Conflicts', fontsize=12)
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        
        # Generate insights
        total_conflicts = data['Conflicts_Over_Social_Media'].sum()
        avg_conflicts = data['Conflicts_Over_Social_Media'].mean()
        max_conflicts_platform = platform_conflicts.loc[
            platform_conflicts['Conflicts_Over_Social_Media'].idxmax()
        ]['Most_Used_Platform']
        min_conflicts_platform = platform_conflicts.loc[
            platform_conflicts['Conflicts_Over_Social_Media'].idxmin()
        ]['Most_Used_Platform']
        
        insights = f"Total Conflicts: {total_conflicts}\n"
        insights += f"Average Conflicts: {avg_conflicts:.2f}\n"
        insights += f"Platform with Most Conflicts: {max_conflicts_platform}\n"
        insights += f"Platform with Fewest Conflicts: {min_conflicts_platform}"
        
        # Convert plot to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
