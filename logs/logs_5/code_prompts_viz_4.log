```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    from pandas.api.types import is_object_dtype, is_integer_dtype
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['Country', 'Addicted_Score']
        if not isinstance(data, pd.DataFrame):
            return None, "Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation
        if not is_object_dtype(data['Country']):
            return None, "Country column must be of object type", False
        if not is_integer_dtype(data['Addicted_Score']):
            return None, "Addicted_Score column must be of integer type", False
        
        # Check for invalid values
        if data['Country'].isnull().any() or data['Addicted_Score'].isnull().any():
            return None, "Input data contains missing values", False
            
        # Data preparation
        # Group by country and calculate mean scores
        country_scores = data.groupby('Country')['Addicted_Score'].mean().reset_index()
        
        # Sort values in descending order
        country_scores = country_scores.sort_values('Addicted_Score', ascending=False)
        
        # Select top 10 countries for visualization
        top_countries = country_scores.head(10)
        
        # Create the visualization
        plt.figure(figsize=(12, 8))
        sns.set_theme(style="whitegrid", palette="husl")
        
        # Use barplot with appropriate parameters
        ax = sns.barplot(x="Country", y="Addicted_Score", data=top_countries,
                         ci=None, errorbar=None)
        
        # Customize the plot
        plt.title('Average Addiction Scores by Country (Top 10)')
        plt.xlabel('Country')
        plt.ylabel('Average Addiction Score')
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        
        # Generate statistical insights
        max_score = top_countries['Addicted_Score'].max()
        min_score = top_countries['Addicted_Score'].min()
        max_country = top_countries.loc[top_countries['Addicted_Score'].idxmax(), 'Country']
        
        insights = f"Top 10 Countries by Average Addiction Score:\n"
        insights += f"• Highest average score: {max_score} ({max_country})\n"
        insights += f"• Lowest average score in top 10: {min_score}\n"
        insights += f"• The scores range from {min_score} to {max_score}\n"
        insights += "This indicates significant variation in addiction patterns across countries."
        
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

