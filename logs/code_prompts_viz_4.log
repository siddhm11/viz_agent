```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['ocean_proximity', 'median_income']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation
        ocean_proximity = data['ocean_proximity']
        median_income = data['median_income']
        
        if not isinstance(ocean_proximity, pd.core.series.Series):
            return None, "Error: ocean_proximity must be a pandas Series", False
            
        if not (isinstance(median_income, pd.core.series.Series) and 
                median_income.dtype.kind in 'ufcmos'):
            return None, "Error: median_income must be a numerical Series", False
            
        # Data preparation
        # Ensure ocean_proximity is treated as categorical
        data['ocean_proximity'] = pd.Categorical(data['ocean_proximity'])
        
        # Remove any potential outliers in median_income that are beyond 1.5 IQR
        Q1 = median_income.quantile(0.25)
        Q3 = median_income.quantile(0.75)
        IQR = Q3 - Q1
        filtered_data = data[~((median_income < (Q1 - 1.5 * IQR)) | 
                             (median_income > (Q3 + 1.5 * IQR)))]
        
        # Create the visualization
        plt.figure(figsize=(12, 8))
        sns.set_style("whitegrid", {'axes.edgecolor': '.2'})
        palette = sns.color_palette("husl", len(filtered_data['ocean_proximity'].cat.categories))
        
        # Create boxplot
        ax = sns.catplot(x='ocean_proximity', y='median_income', data=filtered_data,
                         kind='box', palette=palette, aspect=2)
        
        # Customize the plot
        plt.title('Distribution of Median Income by Ocean Proximity', fontsize=14, pad=20)
        plt.xlabel('Ocean Proximity', fontsize=12)
        plt.ylabel('Median Income', fontsize=12)
        plt.xticks(rotation=45, ha='right')
        
        # Add mean markers
        for i, cat in enumerate(filtered_data['ocean_proximity'].cat.categories):
            mean = filtered_data[filtered_data['ocean_proximity'] == cat]['median_income'].mean()
            plt.plot(i, mean, 'w*', markersize=8, markeredgecolor='black', 
                     markeredgewidth=1, zorder=5)
            
        plt.tight_layout()
        
        # Generate statistical insights
        insights = []
        for cat in filtered_data['ocean_proximity'].cat.categories:
            cat_data = filtered_data[filtered_data['ocean_proximity'] == cat]['median_income']
            mean = cat_data.mean()
            median = cat_data.median()
            std_dev = cat_data.std()
            min_val = cat_data.min()
            max_val = cat_data.max()
            
            insights.append(f"For {cat}:")
            insights.append(f"  Mean: {mean:.2f}")
            insights.append(f"  Median: {median:.2f}")
            insights.append(f"  Standard Deviation: {std_dev:.2f}")
            insights.append(f"  Range: [{min_val:.2f}, {max_val:.2f}]\n")
            
        insights = "\n".join(insights)
        
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
