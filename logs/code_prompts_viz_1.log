```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['ocean_proximity', 'median_house_value']
        if not isinstance(data, pd.DataFrame):
            return None, "Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation
        ocean_proximity = data['ocean_proximity']
        median_house_value = data['median_house_value']
        
        if not isinstance(ocean_proximity, pd.core.series.Series):
            return None, "ocean_proximity must be a pandas Series", False
            
        if not (isinstance(median_house_value, pd.core.series.Series) and 
                median_house_value.dtype.kind in 'ufc'):
            return None, "median_house_value must be a numerical Series", False
        
        # Data cleaning and preparation
        data = data.dropna(subset=['ocean_proximity', 'median_house_value'])
        
        if data.empty:
            return None, "Dataset is empty after removing missing values", False
            
        # Ensure correct data types
        data['ocean_proximity'] = data['ocean_proximity'].astype('category')
        data['median_house_value'] = pd.to_numeric(data['median_house_value'], errors='coerce')
        data = data.dropna(subset=['median_house_value'])
        
        if data.empty:
            return None, "No valid numerical data available", False
            
        # Validate categorical variable
        unique_categories = data['ocean_proximity'].nunique()
        if unique_categories != 5:
            return None, f"Expected 5 unique categories for ocean_proximity, found {unique_categories}", False
            
        # Create the visualization
        plt.figure(figsize=(12, 8))
        sns.set_style("whitegrid")
        sns.set_palette("husl")
        
        ax = sns.boxplot(x='ocean_proximity', y='median_house_value', 
                         data=data, errorbar=None)
        
        plt.title('Distribution of Median House Values by Ocean Proximity', 
                  fontsize=14, fontweight='bold')
        plt.xlabel('Ocean Proximity', fontsize=12)
        plt.ylabel('Median House Value', fontsize=12)
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        
        # Generate statistical insights
        overall_median = data['median_house_value'].median()
        overall_iqr = data['median_house_value'].quantile(0.75) - data['median_house_value'].quantile(0.25)
        
        category_medians = data.groupby('ocean_proximity')['median_house_value'].median()
        category_iqr = data.groupby('ocean_proximity')['median_house_value'].quantile(0.75) - \
                     data.groupby('ocean_proximity')['median_house_value'].quantile(0.25)
        
        insights = f"Overall Median House Value: ${overall_median:,.0f}\n"
        insights += f"Overall IQR: ${overall_iqr:,.0f}\n\n"
        insights += "Median House Values by Ocean Proximity:\n"
        for cat, median in category_medians.items():
            iqr = category_iqr.loc[cat]
            insights += f"{cat}:\nMedian: ${median:,.0f}\nIQR: ${iqr:,.0f}\n"
        
        # Convert to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                   facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

