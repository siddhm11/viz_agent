Here's a complete, robust implementation of the scatter plot visualization function:

```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['total_rooms', 'total_bedrooms']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation
        for col in required_cols:
            if not (isinstance(data[col].dtype, np.dtype) and 
                    np.issubdtype(data[col].dtype, np.number)):
                try:
                    data[col] = data[col].astype(float)
                except ValueError:
                    return None, f"Could not convert {col} to numeric type", False
        
        # Handle missing values
        data = data.dropna(subset=required_cols)
        if len(data) == 0:
            return None, "No valid data points after handling missing values", False
        
        # Data preparation
        x = data['total_rooms'].values
        y = data['total_bedrooms'].values
        
        # Create the visualization
        plt.figure(figsize=(10, 8))
        sns.set_style("whitegrid", {'axes.edgecolor': '.2'})
        
        # Add scatter plot with regression line
        sns.regplot(x=x, y=y, 
                    ci=None,  # Avoid using deprecated ci parameter
                    color='blue', 
                    line_kws={'color': 'red', 'alpha': 0.6},
                    scatter_kws={'alpha': 0.4, 's': 10})
        
        plt.title('Scatter Plot of Total Rooms vs Total Bedrooms', fontsize=14)
        plt.xlabel('Total Rooms', fontsize=12)
        plt.ylabel('Total Bedrooms', fontsize=12)
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        
        # Calculate and display Pearson correlation coefficient
        corr_coef = np.corrcoef(x, y)[0, 1]
        plt.text(max(x), max(y)*0.1, 
                f'Pearson Correlation: {corr_coef:.2f}',
                ha='right', va='bottom', color='red')
        
        # Generate insights
        insights = f"Scatter plot shows the relationship between total rooms and total bedrooms.\n"
        insights += f"Pearson correlation coefficient: {corr_coef:.2f}\n"
        if corr_coef > 0.7:
            insights += "Strong positive correlation observed between the variables."
        elif 0.3 < corr_coef < 0.7:
            insights += "Moderate positive correlation observed between the variables."
        else:
            insights += "Weak or no significant correlation observed between the variables."
        
        # Convert plot to base64 string
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

