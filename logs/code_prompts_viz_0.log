```python
def generate_plot(data):
    import matplotlib.pyplot as plt
    import seaborn as sns
    import pandas as pd
    import numpy as np
    import io
    import base64
    import warnings
    warnings.filterwarnings('ignore')
    
    try:
        # Comprehensive data validation
        required_cols = ['median_income', 'median_house_value']
        if not isinstance(data, pd.DataFrame):
            return None, "Error: Input data must be a pandas DataFrame", False
            
        missing_cols = [col for col in required_cols if col not in data.columns]
        if missing_cols:
            return None, f"Missing columns: {missing_cols}", False
        
        # Data type validation
        for col in required_cols:
            if not (isinstance(data[col].dtype, np.dtype) and 
                    np.issubdtype(data[col].dtype, np.number)):
                return None, f"Column {col} must be of numeric type", False
                
        # Data preparation
        plot_data = data[required_cols].copy()
        if plot_data.empty:
            return None, "Error: Empty data provided", False
        
        # Check for invalid values
        if plot_data['median_income'].hasnans or plot_data['median_house_value'].hasnans:
            return None, "Error: Missing values found in data", False
        
        # Create the visualization
        plt.figure(figsize=(10, 8))
        sns.set_theme(style="whitegrid", font_scale=1.2)
        
        # Add regression line
        sns.regplot(x='median_income', y='median_house_value', 
                    data=plot_data, ci=95, scatter_kws={'alpha': 0.6, 's': 80},
                    line_kws={'color': 'red', 'linewidth': 2},
                    label='Regression Line')
        
        plt.title('Scatter Plot of Median Income vs Median House Value', 
                  fontsize=14, pad=20)
        plt.xlabel('Median Income', fontsize=12)
        plt.ylabel('Median House Value', fontsize=12)
        plt.grid(True, alpha=0.3)
        plt.legend(loc='upper right')
        
        # Calculate Pearson correlation coefficient
        corr, _ = np.corrcoef(plot_data['median_income'], 
                              plot_data['median_house_value'])[0, 1]
        
        # Generate insights
        insights = f"Scatter plot shows the relationship between median income and median house value.\n"
        insights += f"Pearson correlation coefficient: {corr:.2f}\n"
        if abs(corr) > 0.7:
            insights += "Strong positive correlation observed between the variables.\n"
        elif abs(corr) > 0.5:
            insights += "Moderate positive correlation observed between the variables.\n"
        else:
            insights += "Weak to moderate positive correlation observed between the variables.\n"
            
        # Check for outliers using IQR
        q1 = plot_data['median_income'].quantile(0.25)
        q3 = plot_data['median_income'].quantile(0.75)
        iqr = q3 - q1
        income_outliers = plot_data[(plot_data['median_income'] < q1 - 1.5*iqr) | 
                                  (plot_data['median_income'] > q3 + 1.5*iqr)]
        
        if not income_outliers.empty:
            insights += f"Found {len(income_outliers)} potential outliers in the data.\n"
            
        # Convert to base64
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=300, bbox_inches='tight', 
                    facecolor='white', edgecolor='none')
        buf.seek(0)
        img_str = base64.b64encode(buf.read()).decode()
        buf.close()
        plt.close()
        
        return img_str, insights, True
        
    except Exception as e:
        import traceback
        error_details = f"Error: {str(e)}\nTraceback: {traceback.format_exc()}"
        return None, error_details, False
```

